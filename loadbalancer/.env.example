# Copy to .env (same folder as lb.ps1) and fill in. .env is gitignored.
# Format is Java properties: KEY=VALUE, and backslashes must be doubled.
DB_URL=jdbc:mysql://localhost:3306/appdb
DB_USERNAME=root
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
# Public URL short links are built from - your domain in production
APP_BASE_URL=http://localhost:9090/
# Where the Angular frontend is served from (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
